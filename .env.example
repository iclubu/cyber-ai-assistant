# LLM Endpoint URL (required)
# For local/Tailscale Ollama:
OLLAMA_URL=http://100.x.x.x:11435/v1/chat/completions
# For OpenAI/Groq/OpenRouter:
# OLLAMA_URL=https://api.openai.com/v1/chat/completions

# API Key – optional for local models, required for cloud providers
API_KEY=dummy

# If using OpenAI-style API, set this:
# OPENAI_API_KEY=your-api-key-here

# Model name (optional – if you want to override the default in the script)
# MODEL=xxxxx
